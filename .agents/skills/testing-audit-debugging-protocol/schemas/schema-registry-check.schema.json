{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "schema-registry-check",
  "description": "One line of .audit/memory/schema-registry-checks.jsonl — a single naming/uniqueness verification pass against one database, per references/database-schema-standards.md.",
  "type": "object",
  "required": [
    "checkId",
    "timestamp",
    "engineType",
    "connectionRef",
    "schemasFound",
    "tablesFound",
    "indexesFound",
    "namingViolations",
    "duplicateOrConflicting",
    "relatedExecutionRecord"
  ],
  "properties": {
    "checkId": { "type": "string", "pattern": "^SR-[0-9]{3,}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "engineType": { "type": "string" },
    "connectionRef": { "type": "string" },
    "schemasFound": { "type": "integer", "minimum": 0 },
    "tablesFound": { "type": "integer", "minimum": 0 },
    "indexesFound": { "type": "integer", "minimum": 0 },
    "namingViolations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object", "rule"],
        "properties": {
          "object": { "type": "string", "description": "The offending schema/table/index name" },
          "rule": { "type": "string", "description": "Which rule in database-schema-standards.md §1 it breaks" }
        }
      }
    },
    "duplicateOrConflicting": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["objects", "layer"],
        "properties": {
          "objects": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "description": "The two (or more) conflicting object names"
          },
          "layer": {
            "type": "string",
            "enum": ["schema", "table", "index-name", "index-functional-duplicate"],
            "description": "Which layer in database-schema-standards.md §2 caught it"
          }
        }
      }
    },
    "relatedExecutionRecord": { "type": "string", "pattern": "^SU-[0-9]{3,}$" },
    "relatedFindingId": {
      "type": "string",
      "description": "Required (per validator) whenever namingViolations or duplicateOrConflicting is non-empty"
    }
  }
}
