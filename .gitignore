# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Environment / secrets
.env
.env/
.env/admin.txt
.env.local
.env.*.local
.env.release
.env.development
backend/.env
frontend/.env
gateway/.env
# Frontend env-mode files that back the vite builds (envDir: '../') are tracked
# deliberately to make production builds deterministic (no empty API base -> no
# same-origin 405 on Cloudflare Pages). Root .env.release/.env.development (which
# contain secrets) remain ignored above; only the frontend mode files are un-ignored.
!frontend/.env.production
!frontend/.env.development
*.pem
*.key

# Node
node_modules/
dist/
dist-ssr/

# Build artifacts
build-output/
update.zip
tsconfig.tsbuildinfo
tsconfig.*.tsbuildinfo
.sisyphus/
vite.config.js
vite.config.d.ts
vite.config.*.js
vite.config.*.d.ts

# Docker compose overrides
docker-compose.override.yml

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
rent.log

# Data (never commit user data)
storage/

# Temporary
scratch/
output/
*.zip
.gstack/
.opencode/

# runtime sqlite artifacts
backend/app/app/database/tenant.db
