# Frontend build-time VITE_* vars for PRODUCTION (Cloudflare Pages / release).
# Loaded automatically by `vite build` (production mode) via envDir: '../', and
# takes priority over the generic frontend/.env.
#
# The API base must point at the self-hosted backend gateway so the Pages bundle
# calls api.vijaykrsha.online instead of same-origin (which would 405 on Pages,
# which has no API proxy). Vite bakes these in at build time; a rebuild + redeploy
# is required after any change.

VITE_APP_BASE_PATH=/rent

VITE_API_BASE_URL=https://api.vijaykrsha.online

# Google OAuth client id for the landlord login button (@react-oauth/google).
# Must match GOOGLE_CLIENT_ID in backend/.env.
VITE_GOOGLE_CLIENT_ID=682816703845-ek2up1l56iah950pohj1ol3h7ijlidmr.apps.googleusercontent.com
