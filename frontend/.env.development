# Frontend build-time VITE_* vars for DEVELOPMENT.
# Loaded automatically by `vite dev` (development mode) via envDir: '../', and
# takes priority over the generic frontend/.env.
#
# Dev keeps the API base EMPTY so the frontend calls same-origin (/rent/...) and
# the nginx/backend proxy routes it. Vite bakes these in at build time; restart
# the dev server after any change.

VITE_APP_BASE_PATH=/rent

# Empty => same-origin (/rent/...). The backend-served build proxies through
# /rent/, so same-origin is correct for dev.
VITE_API_BASE_URL=

# Google OAuth client id for the landlord login button (@react-oauth/google).
# Must match GOOGLE_CLIENT_ID in backend/.env.
VITE_GOOGLE_CLIENT_ID=682816703845-ek2up1l56iah950pohj1ol3h7ijlidmr.apps.googleusercontent.com
