# Frontend build-time VITE_* vars for DEVELOPMENT (Cloudflare Pages dev branch).
# Loaded automatically by `vite build` (development mode) via envDir: '../', and
# takes priority over the generic frontend/.env. CI (deploy-pages.yml) injects
# VITE_API_BASE_URL as a process env var, which overrides this file — this file
# only matters for a local `vite dev`.
#
# The dev FRONTEND is hosted on Cloudflare Pages (dev.rent-8rf.pages.dev) and
# calls the DEV API through the ngrok tunnel (dev backend origin), never
# same-origin. Vite bakes these in at build time; restart the dev server after
# any change.

VITE_APP_BASE_PATH=/

# Dev API origin (ngrok tunnel) — the dev backend API. Same-origin would 405 on
# Pages, which has no API proxy.
VITE_API_BASE_URL=https://endomorphic-semiprotectively-jamaal.ngrok-free.dev

# Google OAuth client id for the landlord login button (@react-oauth/google).
# Must match GOOGLE_CLIENT_ID in backend/.env.
VITE_GOOGLE_CLIENT_ID=682816703845-ek2up1l56iah950pohj1ol3h7ijlidmr.apps.googleusercontent.com
